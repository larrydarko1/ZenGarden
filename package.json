{
    "name": "zen-garden",
    "version": "2.1.2",
    "description": "A local-only meditation and mindfulness app built with Vue 3. Runs completely offline with no server required.",
    "keywords": [
        "meditation",
        "mindfulness",
        "zen",
        "electron",
        "vue",
        "offline",
        "local-first",
        "privacy",
        "desktop-app",
        "capacitor"
    ],
    "homepage": "https://github.com/larrydarko1/ZenGarden#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/ZenGarden/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Lorenzo Mazzola",
        "email": "hello@larrydarko.dev"
    },
    "type": "module",
    "main": "out/main/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/ZenGarden.git"
    },
    "scripts": {
        "predev": "install-electron",
        "dev": "electron-vite dev",
        "typecheck": "vue-tsc -b tsconfig.json",
        "build": "npm run typecheck && electron-vite build",
        "build:electron": "npm run build && electron-builder",
        "build:mac": "npm run build && electron-builder --mac --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "build:mobile": "vite build && npx cap sync",
        "cap:sync": "npx cap sync",
        "build:android": "npm run build:mobile && android/gradlew -p android assembleDebug && mkdir -p dist-android && cp android/app/build/outputs/apk/debug/app-debug.apk dist-android/ZenGarden-$npm_package_version-debug.apk",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json}\"",
        "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
        "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "npx vitest run --coverage",
        "ci:check": "npm run lint && npm run format:check && npm run stylelint && npm run test:coverage && npm run check && npm run build",
        "check": "larry check"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/cli": "^8.5.3",
        "@capacitor/core": "^8.5.3",
        "@capacitor/filesystem": "^8.1.5",
        "@capacitor/preferences": "^8.0.1",
        "electron-log": "^5.4.4",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@larrydarko/lint-config": "^0.1.0-beta.10",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "electron": "^45.0.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^6.0.0",
        "jsdom": "^30.1.3",
        "sass-embedded": "^1.106.1",
        "typescript": "~6.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13",
        "yaml": "^2.9.1"
    },
    "packageManager": "npm@11.11.0",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "os": [
        "darwin",
        "linux"
    ],
    "private": true,
    "build": {
        "appId": "com.zengarden.app",
        "productName": "ZenGarden",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            "build/icon.png",
            {
                "from": "out",
                "to": "out",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "dmg": {
            "background": "build/dmg-background.png",
            "iconSize": 100,
            "iconTextSize": 14,
            "title": "${productName} ${version}",
            "contents": [
                {
                    "x": 180,
                    "y": 260
                },
                {
                    "x": 480,
                    "y": 260,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "mac": {
            "category": "public.app-category.healthcare-fitness",
            "identity": null,
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "rpm",
                "tar.gz"
            ],
            "category": "Utility",
            "maintainer": "Lorenzo Mazzola",
            "vendor": "Lorenzo Mazzola",
            "synopsis": "A local-only meditation and mindfulness app built with Vue 3. Runs completely offline with no server required.",
            "syncDesktopName": true
        }
    }
}
