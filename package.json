{
    "name": "zen-garden",
    "version": "2.1.2",
    "description": "A local-only meditation and mindfulness app built with Vue 3. Runs completely offline with no server required.",
    "keywords": [
        "meditation",
        "mindfulness",
        "zen",
        "electron",
        "vue",
        "offline",
        "local-first",
        "privacy",
        "desktop-app",
        "capacitor"
    ],
    "homepage": "https://github.com/larrydarko1/ZenGarden#readme",
    "bugs": {
        "url": "https://github.com/larrydarko1/ZenGarden/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Lorenzo Mazzola",
        "email": "hello@larrydarko.dev"
    },
    "type": "module",
    "main": "out/main/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/ZenGarden.git"
    },
    "scripts": {
        "predev": "install-electron",
        "dev": "electron-vite dev",
        "typecheck": "vue-tsc -b tsconfig.json",
        "build": "npm run typecheck && electron-vite build",
        "build:electron": "npm run build && electron-builder",
        "build:mac": "npm run build && electron-builder --mac --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "build:mobile": "vite build && npx cap sync",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "cap:run:android": "JAVA_HOME=/Applications/Android\\ Studio.app/Contents/jbr/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk npm run build:mobile && JAVA_HOME=/Applications/Android\\ Studio.app/Contents/jbr/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk npx cap run android",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json}\"",
        "audit:check": "node scripts/check/check-audit.ts",
        "code:check": "node scripts/check/check-code-style.ts",
        "dead:check": "node scripts/check/check-dead-code.ts",
        "declorder:check": "node scripts/check/check-declaration-order.ts",
        "dup:check": "node scripts/check/check-duplication.ts",
        "error:check": "node scripts/check/check-error-handling.ts",
        "html:check": "node scripts/check/check-html-standards.ts",
        "i18n:check": "node scripts/check/check-i18n.ts",
        "ipc:check": "node scripts/check/check-ipc-standards.ts",
        "pipeline:check": "node scripts/check/check-pipeline.ts",
        "pkg:check": "node scripts/check/check-package-json.ts",
        "refactor:check": "node scripts/check/check-refactoring.ts",
        "scss:check": "node scripts/check/check-scss-standards.ts",
        "security:check": "node scripts/check/check-electron-security.ts",
        "test:check": "node scripts/check/check-testing.ts",
        "tsconfig:check": "node scripts/check/check-tsconfigs.ts",
        "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
        "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "npx vitest run --coverage",
        "ci:check": "npm run audit:check && npm run lint && npm run format:check && npm run stylelint && npm run pkg:check && npm run pipeline:check && npm run code:check && npm run declorder:check && npm run html:check && npm run scss:check && npm run refactor:check && npm run ipc:check && npm run security:check && npm run error:check && npm run dup:check && npm run dead:check && npm run i18n:check && npm run tsconfig:check && npm run test:coverage && npm run test:check && npm run build"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.1",
        "@capacitor/cli": "^8.0.1",
        "@capacitor/core": "^8.0.1",
        "@capacitor/filesystem": "^8.1.0",
        "@capacitor/preferences": "^8.0.0",
        "electron-log": "~5.4.3",
        "vue": "^3.5.17",
        "vue-i18n": "^11.4.10",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@larrydarko/lint-config": "^0.1.0-beta.0",
        "@types/node": "^24.0.13",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.11",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "electron": "^44.0.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "jsdom": "^30.0.1",
        "sass-embedded": "^1.103.1",
        "typescript": "~6.0.2",
        "vite": "^7.0.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "os": [
        "darwin",
        "linux"
    ],
    "private": true,
    "packageManager": "npm@11.11.0",
    "build": {
        "appId": "com.zengarden.app",
        "productName": "ZenGarden",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            "build/icon.png",
            {
                "from": "out",
                "to": "out",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "dmg": {
            "background": "build/dmg-background.png",
            "iconSize": 100,
            "iconTextSize": 14,
            "title": "${productName} ${version}",
            "contents": [
                {
                    "x": 180,
                    "y": 260
                },
                {
                    "x": 480,
                    "y": 260,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "mac": {
            "category": "public.app-category.healthcare-fitness",
            "identity": null,
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb",
                "rpm",
                "tar.gz"
            ],
            "category": "Utility",
            "maintainer": "Lorenzo Mazzola",
            "vendor": "Lorenzo Mazzola",
            "synopsis": "A local-only meditation and mindfulness app built with Vue 3. Runs completely offline with no server required.",
            "syncDesktopName": true
        }
    }
}
