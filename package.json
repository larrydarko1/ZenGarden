{
    "name": "zen-garden",
    "private": true,
    "version": "1.1.9",
    "type": "module",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "vue-tsc -b && electron-vite build",
        "build:electron": "npm run build && electron-builder",
        "build:mac": "npm run build && electron-builder --mac --publish never",
        "build:win": "npm run build && electron-builder --win --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "build:mobile": "vite build && npx cap sync",
        "cap:sync": "npx cap sync",
        "cap:open:android": "npx cap open android",
        "cap:run:android": "JAVA_HOME=/Applications/Android\\ Studio.app/Contents/jbr/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk npm run build:mobile && JAVA_HOME=/Applications/Android\\ Studio.app/Contents/jbr/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk npx cap run android",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,scss,json}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "ci:check": "npm audit --audit-level=high --omit=dev && npm run lint && npm run format:check && npm test && npm run build"
    },
    "lint-staged": {
        "*.{ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@capacitor/android": "^8.0.1",
        "@capacitor/cli": "^8.0.1",
        "@capacitor/core": "^8.0.1",
        "@capacitor/filesystem": "^8.1.0",
        "@capacitor/preferences": "^8.0.0",
        "argon2": "^0.44.0",
        "vue": "^3.5.17",
        "vue-i18n": "^9.14.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.13",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.8.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "sass-embedded": "^1.92.1",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.57.1",
        "vite": "^7.0.0",
        "vitest": "^3.2.4",
        "vue-tsc": "^2.2.10"
    },
    "description": "A local-only meditation and mindfulness app built with Vue 3. Runs completely offline with no server required.",
    "author": "Lorenzo Mazzola",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/larrydarko1/ZenGarden.git"
    },
    "build": {
        "appId": "com.zengarden.app",
        "productName": "ZenGarden",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            {
                "from": "out",
                "to": "out",
                "filter": [
                    "**/*"
                ]
            },
            "node_modules/**/*"
        ],
        "mac": {
            "category": "public.app-category.healthcare-fitness",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.icns"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Utility"
        }
    }
}
